{
  "name": "vintasend-templates-management-dashboard-core",
  "version": "1.0.0-alpha1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/vintasend-templates-management-dashboard-core.git"
  },
  "description": "Headless React core for VintaSend template-management dashboards: a generated OpenAPI client, TanStack Query hooks, and URL-driven template and tag filters",
  "license": "MIT",
  "author": "Vinta Software",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:api": "openapi-typescript ../vintasend-templates-management-api/openapi.yaml -o src/api/schema.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "next": ">=14",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tanstack/react-query": "^5.102.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.0.0",
    "next": "^16.1.6",
    "openapi-typescript": "^7.13.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vintasend",
    "templates",
    "openapi",
    "react-query",
    "tanstack",
    "headless"
  ]
}
